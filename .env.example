# Execute python infra/init_env.py para gerar segredos locais aleatórios.
APP_ENV=development
DEMO_MODE=true
COOKIE_SECURE=false
PUBLIC_URL=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:8000
POSTGRES_PASSWORD=
DATABASE_URL=
TOKEN_SECRET=
# Configure o endereço completo; não será exibido no catálogo público.
PICKUP_ADDRESS=
# Lista de CEPs urbanos autorizados pela operação, separados por vírgula.
# Em demonstração, somente 13630000 é aceito para teste de entrega.
DELIVERY_ALLOWED_CEPS=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE=
DATA_RETENTION_DAYS=90
